{
  "name": "@pikecode/api-key-manager",
  "version": "1.3.1",
  "description": "A CLI tool for managing and switching multiple API provider configurations",
  "main": "src/index.js",
  "bin": {
    "akm": "bin/akm.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/akm.js",
    "dev": "nodemon bin/akm.js",
    "test": "jest",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "build": "echo 'No build needed'",
    "prepare": "echo 'Preparing package'",
    "prepublishOnly": "npm test",
    "release": "npm version patch && npm publish --access public"
  },
  "keywords": [
    "api",
    "api-key",
    "key-manager",
    "authentication",
    "anthropic",
    "anthropic-api-key",
    "anthropic-auth-token",
    "openai",
    "openai-api-key",
    "codex",
    "codex-cli",
    "claude-code",
    "environment",
    "config",
    "provider",
    "switcher",
    "cli",
    "command-line",
    "tool"
  ],
  "author": "pikecode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikecode/api-key-manager.git"
  },
  "bugs": {
    "url": "https://github.com/pikecode/api-key-manager/issues"
  },
  "homepage": "https://github.com/pikecode/api-key-manager#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "0.71.2",
    "chalk": "^4.1.2",
    "commander": "14.0.2",
    "cross-spawn": "^7.0.3",
    "fs-extra": "^11.1.1",
    "inquirer": "^8.2.6",
    "supports-color": "^9.4.0"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "30.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ]
}
